<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for the BOOT_COMPLETED broadcast to actually be
         delivered to StratumReceiver. Without this permission the
         <receiver> below silently never fires — no crash, no error,
         it just never gets called. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <service android:name="com.stratum.runtime.StratumService" />

        <receiver android:name="com.stratum.runtime.StratumReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>